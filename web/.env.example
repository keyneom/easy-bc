# Public Google OAuth 2.0 Web client ID. This is not a client secret.
# Authorize https://keyneom.github.io as a JavaScript origin in Google Cloud.
VITE_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Google Picker + Drive Open-with for joining shared encrypted sync folders.
# Enable the Picker API on the same Google Cloud project.
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
